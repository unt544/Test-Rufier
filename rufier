class MyScreen3(Screen):
    def __init__(self, **kwargs):
        super(MyScreen3, self).__init__(**kwargs)
        main_layout = BoxLayout(orientation='vertical', padding=50, spacing=20)
        
        timer_layout = BoxLayout(orientation='horizontal', size_hint=(1, 0.35))
        timer_layout.add_widget(Label(size_hint_x=0.7))
        
        right_panel = BoxLayout(orientation='vertical', size_hint=(None, None), width=120, height=110, padding=10, spacing=10)
        
        self.timer_label = Label(text="0", font_size=28, size_hint=(1, 0.5), color=(0.98, 0.92, 0.84, 1))
        right_panel.add_widget(self.timer_label)
        
        self.btn_timer = Button(text="Старт", size_hint=(1, 0.5), background_color=(0.45, 0.25, 0.65, 1), background_normal='', color=(0.98, 0.92, 0.84, 1))
        self.btn_timer.bind(on_release=self.start_timer)
        right_panel.add_widget(self.btn_timer)
        
        timer_layout.add_widget(right_panel)
        main_layout.add_widget(timer_layout)
        
        self.lbl = Label(text='Выполните 30 приседаний за 45 секунд.', font_size=16, halign='center', valign='top', text_size=(700, None), size_hint=(1, 0.35), color=(0.98, 0.92, 0.84, 1))
        main_layout.add_widget(self.lbl)
        
        self.btn = Button(text="Продолжить", size_hint=(None, None), width=240, height=65, pos_hint={'center_x': 0.5}, background_color=(0.45, 0.25, 0.65, 1), background_normal='', color=(0.98, 0.92, 0.84, 1))
        self.btn.bind(on_release=self.go_forward)
        main_layout.add_widget(self.btn)
        
        self.add_widget(main_layout)
        self.time_passed = 0
        self.timer_event = None

    def start_timer(self, instance):
        if not self.timer_event:
            self.time_passed = 0
            self.timer_label.text = "0"
            self.timer_event = Clock.schedule_interval(self.update_timer, 1)

    def update_timer(self, dt):
        self.time_passed += 1
        self.timer_label.text = str(self.time_passed)
        if self.time_passed >= 45:
            Clock.unschedule(self.timer_event)
            self.timer_event = None

    def on_leave(self):
        if self.timer_event:
            Clock.unschedule(self.timer_event)
            self.timer_event = None
        self.timer_label.text = "0"

    def go_forward(self, instance):
        self.manager.transition = FadeTransition(duration=0.3)
        self.manager.current = 'scr4'


