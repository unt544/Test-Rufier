def get_ruffier_result(r_index, age):
    if age < 7:
        return "Данные для возраста младше 7 лет не поддерживаются."
    
    if age == 7 or age == 8:
        level_excellent = 6.5
        level_good = 12.0
        level_satisfactory = 17.0
        level_poor = 21.0
    elif age == 9 or age == 10:
        level_excellent = 5.0
        level_good = 10.5
        level_satisfactory = 15.5
        level_poor = 19.5
    elif age == 11 or age == 12:
        level_excellent = 3.5
        level_good = 9.0
        level_satisfactory = 14.0
        level_poor = 18.0
    elif age == 13 or age == 14:
        level_excellent = 2.0
        level_good = 7.5
        level_satisfactory = 12.5
        level_poor = 16.5
    else:
        level_excellent = 0.5
        level_good = 6.0
        level_satisfactory = 11.0
        level_poor = 15.0

    if r_index <= level_excellent:
        return "высокая"
    elif r_index <= level_good:
        return "выше среднего"
    elif r_index <= level_satisfactory:
        return "средняя"
    elif r_index <= level_poor:
        return "удовлетворительная"
    else:
        return "слабая"


