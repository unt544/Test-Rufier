class MyScreen5(Screen):
    def __init__(self, **kwargs):
        super(MyScreen5, self).__init__(**kwargs)
        layout = BoxLayout(orientation='vertical', padding=50)
        self.lbl = Label(text='', font_size=16, halign='left', valign='middle', text_size=(500, None), color=(0.98, 0.92, 0.84, 1))
        layout.add_widget(self.lbl)
        self.add_widget(layout)

    def on_enter(self):
        app = App.get_running_app()
        r_index = ((app.p1 + app.p2 + app.p3) * 4 - 200) / 10
        status = get_ruffier_result(r_index, app.user_age)
        
        r_str = str(round(r_index, 1))
        self.lbl.text = "Ваш индекс Руфье: " + r_str + "\nРаботоспособность сердца:\n" + status
        
        sound = SoundLoader.load('apple-pay-succes.mp3')
        if sound:
            sound.volume = 1.0
            sound.play()


class MyHeart(App):
    def build(self):
        self.user_name = ""
        self.user_age = 7
        self.p1 = 0
        self.p2 = 0
        self.p3 = 0
        
        sm = ScreenManager()
        sm.add_widget(MyScreen1(name='scr1'))
        sm.add_widget(MyScreen2(name='scr2'))
        sm.add_widget(MyScreen3(name='scr3'))
        sm.add_widget(MyScreen4(name='scr4'))
        sm.add_widget(MyScreen5(name='scr5'))
        return sm


if __name__ == '__main__':
    MyHeart().run()
